{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routecodex-hooks/daemon-config/v1",
  "title": "HooksDaemonConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime", "codexapp", "policies"],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "state_directory"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "state_directory": { "type": "string", "minLength": 1 }
      }
    },
    "codexapp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["socket", "required_capabilities", "source_address", "target_scopes"],
      "properties": {
        "socket": { "type": "string", "minLength": 1 },
        "required_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "source_address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scopeId", "sessionId"],
          "properties": {
            "scopeId": { "type": "string", "minLength": 1 },
            "sessionId": { "type": "string", "minLength": 1 }
          }
        },
        "target_scopes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "enabled", "config"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "config": { "type": "object" }
        }
      }
    }
  }
}
