{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "project": "routecodex-hooks",
  "feature": "rccs-snapshot-recovery",
  "owner": "rccs-recover",
  "source": "src/rccs-recover.sh",
  "cli": {
    "standalone": ["backup", "list", "restore"],
    "wrapper": "rccs snapshot"
  },
  "nodes": [
    { "id": "command", "owner": "rccs-recover", "kind": "entry" },
    { "id": "backup", "owner": "rccs-recover", "kind": "operation" },
    { "id": "backup_validate", "owner": "rccs-recover", "kind": "gate" },
    { "id": "backup_copy", "owner": "rccs-recover", "kind": "operation" },
    { "id": "backup_manifest", "owner": "rccs-recover", "kind": "operation" },
    { "id": "snapshot_ready", "owner": "rccs-recover", "kind": "terminal" },
    { "id": "list", "owner": "rccs-recover", "kind": "operation" },
    { "id": "list_result", "owner": "rccs-recover", "kind": "terminal" },
    { "id": "restore", "owner": "rccs-recover", "kind": "operation" },
    { "id": "restore_resolve", "owner": "rccs-recover", "kind": "gate" },
    { "id": "snapshot_verify", "owner": "rccs-recover", "kind": "gate" },
    { "id": "snapshot_config_check", "owner": "snapshot-rccv3", "kind": "gate" },
    { "id": "rollback_save", "owner": "rccs-recover", "kind": "operation" },
    { "id": "live_replace", "owner": "rccs-recover", "kind": "operation" },
    { "id": "live_config_check", "owner": "restored-rccv3", "kind": "gate" },
    { "id": "runtime_restart", "owner": "restored-rccv3", "kind": "gate" },
    { "id": "restore_success", "owner": "rccs-recover", "kind": "terminal" },
    { "id": "rollback_restore", "owner": "rccs-recover", "kind": "operation" },
    { "id": "previous_state_restored", "owner": "rccs-recover", "kind": "terminal" },
    { "id": "rollback_failure", "owner": "rccs-recover", "kind": "terminal" },
    { "id": "reject_before_mutation", "owner": "rccs-recover", "kind": "terminal" }
  ],
  "edges": [
    { "from": "command", "to": "backup", "event": "backup" },
    { "from": "command", "to": "list", "event": "list" },
    { "from": "command", "to": "restore", "event": "restore" },
    { "from": "backup", "to": "backup_validate", "event": "validate_backup_inputs" },
    { "from": "backup_validate", "to": "backup_copy", "event": "backup_inputs_valid" },
    { "from": "backup_validate", "to": "reject_before_mutation", "event": "backup_inputs_invalid" },
    { "from": "backup_copy", "to": "backup_manifest", "event": "backup_copy_complete" },
    { "from": "backup_manifest", "to": "snapshot_ready", "event": "snapshot_ready" },
    { "from": "list", "to": "list_result", "event": "list_complete" },
    { "from": "restore", "to": "restore_resolve", "event": "resolve_snapshot" },
    { "from": "restore_resolve", "to": "snapshot_verify", "event": "snapshot_id_valid" },
    { "from": "restore_resolve", "to": "reject_before_mutation", "event": "snapshot_id_invalid" },
    { "from": "snapshot_verify", "to": "snapshot_config_check", "event": "snapshot_verified" },
    { "from": "snapshot_verify", "to": "reject_before_mutation", "event": "snapshot_invalid" },
    { "from": "snapshot_config_check", "to": "rollback_save", "event": "snapshot_config_valid" },
    { "from": "snapshot_config_check", "to": "reject_before_mutation", "event": "snapshot_config_invalid" },
    { "from": "rollback_save", "to": "live_replace", "event": "rollback_saved" },
    { "from": "live_replace", "to": "live_config_check", "event": "live_paths_replaced" },
    { "from": "live_config_check", "to": "runtime_restart", "event": "live_config_valid" },
    { "from": "live_config_check", "to": "rollback_restore", "event": "live_config_invalid" },
    { "from": "runtime_restart", "to": "restore_success", "event": "restore_runtime_ready" },
    { "from": "runtime_restart", "to": "rollback_restore", "event": "restore_runtime_failed" },
    { "from": "rollback_restore", "to": "previous_state_restored", "event": "rollback_ok" },
    { "from": "rollback_restore", "to": "rollback_failure", "event": "rollback_failed" }
  ],
  "resources": [
    { "id": "snapshot_root", "owner": "rccs-recover", "mutable": true },
    { "id": "rollback_root", "owner": "rccs-recover", "mutable": true },
    { "id": "live_bin_dir", "owner": "rccs-recover", "mutable": true },
    { "id": "live_config", "owner": "rccs-recover", "mutable": true },
    { "id": "live_provider", "owner": "rccs-recover", "mutable": true },
    { "id": "live_secrets", "owner": "rccs-recover", "mutable": true },
    { "id": "live_aliases", "owner": "rccs-recover", "mutable": true }
  ],
  "implementation_bindings": [
    { "node": "backup", "symbol": "backup_command", "resources": ["snapshot_root"] },
    { "node": "list", "symbol": "list_command", "resources": ["snapshot_root"] },
    { "node": "restore", "symbol": "restore_command", "resources": ["live_bin_dir", "live_config", "live_provider", "live_secrets", "live_aliases"] },
    { "node": "restore_resolve", "symbol": "resolve_snapshot", "resources": ["snapshot_root"] },
    { "node": "snapshot_verify", "symbol": "verify_snapshot", "resources": ["snapshot_root"] },
    { "node": "rollback_save", "symbol": "save_rollback", "resources": ["rollback_root", "live_bin_dir", "live_config", "live_provider", "live_secrets", "live_aliases"] },
    { "node": "live_replace", "symbol": "restore_tree", "resources": ["live_bin_dir", "live_config", "live_provider", "live_secrets", "live_aliases"] },
    { "node": "rollback_restore", "symbol": "rollback_restore", "resources": ["rollback_root", "live_bin_dir", "live_config", "live_provider", "live_secrets", "live_aliases"] },
    { "node": "runtime_restart", "symbol": "runtime_restart", "resources": ["live_config"] }
  ],
  "invariants": [
    "snapshot IDs are confined to the backup root",
    "latest is updated only after manifest and metadata are written",
    "restore verifies manifest and config before live mutation",
    "rollback restores exactly the pre-restore managed paths",
    "rollback failure is reported without claiming restoration",
    "list is read-only",
    "standalone recovery does not require Node or the daemon"
  ],
  "required_evidence_events": [
    "backup",
    "list",
    "restore",
    "snapshot_invalid",
    "snapshot_config_invalid",
    "rollback_ok",
    "rollback_failed"
  ],
  "evidence": [
    { "event": "backup", "test": "test/snapshot-recover.test.js", "case": "backs up binaries, config, provider, secrets, and aliases" },
    { "event": "list", "test": "test/snapshot-recover.test.js", "case": "backs up binaries, config, provider, secrets, and aliases" },
    { "event": "restore", "test": "test/snapshot-recover.test.js", "case": "restores files and invokes only managed rccv3 lifecycle commands" },
    { "event": "snapshot_invalid", "test": "test/snapshot-recover.test.js", "case": "rejects a tampered snapshot before changing live files" },
    { "event": "snapshot_invalid", "test": "test/snapshot-recover.test.js", "case": "rejects unlisted files before changing live files" },
    { "event": "snapshot_config_invalid", "test": "test/snapshot-recover.test.js", "case": "rejects a snapshot whose config check fails" },
    { "event": "rollback_ok", "test": "test/snapshot-recover.test.js", "case": "rollback removes paths that did not exist before restore" },
    { "event": "rollback_failed", "test": "test/snapshot-recover.test.js", "case": "reports rollback failure instead of claiming restoration" },
    { "event": "backup", "test": "test/cli-help.test.js", "case": "snapshot help exits without daemon access or mutation" },
    { "event": "restore", "test": "test/init.test.js", "case": "init installs local source, skills, wrappers, and one managed Stop hook idempotently" }
  ]
}
