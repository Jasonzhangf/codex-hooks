{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routecodex-hooks/delivery-receipt/v1",
  "title": "DeliveryReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "state", "attempt_id", "observed_at"],
  "properties": {
    "intent_id": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["created", "suppressed", "queued", "deferred", "emitted", "sending", "accepted", "sent", "delivered", "executed", "replied", "read", "consumed", "acknowledged", "failed", "unknown_delivery", "retryable", "deduplicated", "expired", "cancelled"]
    },
    "attempt_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "error": { "type": ["object", "null"] },
    "native": { "type": ["object", "null"] }
  }
}
