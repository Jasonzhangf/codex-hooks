{
  "runtime": {
    "host": "127.0.0.1",
    "port": 8787,
    "state_directory": "~/.codex/routecodex-hooks/state"
  },
  "codexapp": {
    "socket": "~/.codex/routecodex-hooks/codexapp.sock",
    "required_capabilities": ["session_status", "send_message_to_thread"],
    "source_address": { "scopeId": "local:hooks", "sessionId": "hooksd" },
    "target_scopes": {
      "codex_tui/tui-appserver": "local:tui",
      "codex_app/desktop-appserver": "local:desktop"
    }
  },
  "policies": []
}
