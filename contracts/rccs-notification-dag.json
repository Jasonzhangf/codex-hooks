    { "id": "working_active", "owner": "hooksd", "kind": "gate" },
    { "id": "interrupted_idle", "owner": "hooksd", "kind": "gate" },
    { "id": "starting_stopping", "owner": "hooksd", "kind": "gate" },
    { "id": "fail_closed", "owner": "hooksd", "kind": "gate" },
    { "id": "recheck_trigger", "owner": "hooksd", "kind": "event" },
    { "id": "skipped", "owner": "policy.timer", "kind": "terminal" },
    { "id": "deferred", "owner": "policy.timer", "kind": "state" },
    { "id": "queue_intent", "owner": "hooksd.transport", "kind": "operation" },
    { "id": "native_accepted", "owner": "codexapp", "kind": "receipt" },
    { "id": "delivered", "owner": "codexapp", "kind": "evidence" },
    { "id": "executed", "owner": "codexapp", "kind": "evidence" },
    { "id": "replied", "owner": "codexapp", "kind": "evidence" },
    { "id": "read", "owner": "codexapp", "kind": "evidence" },
    { "id": "unknown_delivery", "owner": "hooksd.transport", "kind": "state" },
    { "id": "reconcile", "owner": "hooksd.transport", "kind": "operation" },
    { "id": "terminal_failure", "owner": "policy.timer", "kind": "terminal" }
  ],
  "edges": [
    { "from": "control_mutation", "to": "longhorizon_goal_active", "event": "register_goal" },
    { "from": "longhorizon_goal_active", "to": "liveness_scheduled", "event": "schedule_first_probe" },
    { "from": "control_mutation", "to": "schedule_persisted", "event": "register_schedule" },
    { "from": "liveness_scheduled", "to": "timer_due", "event": "clock_due" },
    { "from": "schedule_persisted", "to": "timer_due", "event": "clock_due" },
    { "from": "timer_due", "to": "appserver_native_status", "event": "read_session_status" },
    { "from": "appserver_native_status", "to": "appserver_active_running", "event": "native_active_or_running" },
    { "from": "appserver_native_status", "to": "appserver_interrupted", "event": "native_interrupted_or_cancelled" },
    { "from": "appserver_native_status", "to": "appserver_idle", "event": "native_idle" },
    { "from": "appserver_native_status", "to": "appserver_starting_stopping", "event": "native_starting_or_stopping" },
    { "from": "appserver_native_status", "to": "appserver_system_error", "event": "native_system_error" },
    { "from": "appserver_native_status", "to": "appserver_unknown_disconnected", "event": "native_unknown_disconnected_or_not_loaded" },
    { "from": "appserver_active_running", "to": "session_observed", "event": "normalize_active_running_to_working" },
    { "from": "appserver_interrupted", "to": "session_observed", "event": "normalize_interrupted_cancelled_to_interrupted" },
    { "from": "appserver_idle", "to": "session_observed", "event": "normalize_idle" },
    { "from": "appserver_starting_stopping", "to": "session_observed", "event": "normalize_starting_stopping" },
    { "from": "appserver_system_error", "to": "session_observed", "event": "normalize_system_error_to_failed" },
    { "from": "appserver_unknown_disconnected", "to": "session_observed", "event": "normalize_unknown_disconnected_or_not_loaded" },
    { "from": "session_observed", "to": "working_active", "event": "state_working" },
    { "from": "session_observed", "to": "interrupted_idle", "event": "state_interrupted_or_idle" },
    { "from": "session_observed", "to": "starting_stopping", "event": "state_starting_or_stopping" },
    { "from": "session_observed", "to": "fail_closed", "event": "state_unknown_disconnected_failed_or_missing" },
    { "from": "working_active", "to": "skipped", "event": "busy_policy_skip" },
    { "from": "starting_stopping", "to": "deferred", "event": "persist_pending" },
    { "from": "recheck_trigger", "to": "session_rechecked", "event": "legal_state_recheck" },
    { "from": "session_rechecked", "to": "working_active", "event": "state_working" },
    { "from": "session_rechecked", "to": "interrupted_idle", "event": "state_interrupted_or_idle" },
    { "from": "session_rechecked", "to": "starting_stopping", "event": "state_starting_or_stopping" },
    { "from": "session_rechecked", "to": "fail_closed", "event": "state_unknown_disconnected_failed_or_missing" },
    { "from": "interrupted_idle", "to": "queue_intent", "event": "queue_wake" },
    { "from": "queue_intent", "to": "native_accepted", "event": "native_accept" },
    { "from": "native_accepted", "to": "delivered", "event": "target_receipt" },
    { "from": "delivered", "to": "executed", "event": "execution_evidence" },
    { "from": "executed", "to": "replied", "event": "response_evidence" },
    { "from": "replied", "to": "read", "event": "read_cursor" },
    { "from": "queue_intent", "to": "unknown_delivery", "event": "uncertain_transport" },
    { "from": "unknown_delivery", "to": "reconcile", "event": "reconcile_attempt" },
    { "from": "reconcile", "to": "delivered", "event": "matching_receipt" },
    { "from": "fail_closed", "to": "terminal_failure", "event": "record_failure" }
  ],
  "resources": [
    { "id": "schedule_state", "owner": "policy.timer", "mutable": true },
    { "id": "longhorizon_state", "owner": "policy.longhorizon", "mutable": true },
    { "id": "session_status", "owner": "codexapp", "mutable": false },
    { "id": "message_intent", "owner": "policy", "mutable": false },
    { "id": "delivery_receipt", "owner": "hooksd.transport", "mutable": true }
  ],
  "implementation_bindings": [
    { "node": "longhorizon_goal_active", "symbol": "registerLongHorizon", "resources": ["longhorizon_state", "schedule_state"] },
    { "node": "liveness_scheduled", "symbol": "upsertSchedule", "resources": ["schedule_state"] },
    { "node": "timer_due", "symbol": "tick", "resources": ["schedule_state", "session_status"] },
    { "node": "queue_intent", "symbol": "dispatchNotify", "resources": ["message_intent"] },
    { "node": "native_accepted", "symbol": "send", "resources": ["delivery_receipt"] },
    { "node": "unknown_delivery", "symbol": "recoverOutbox", "resources": ["delivery_receipt"] },
    { "node": "reconcile", "symbol": "reconcileDeliveryEvidence", "resources": ["delivery_receipt"] }
  ],
  "invariants": [
    "registering a LongHorizon goal record activates it by default",
    "the first liveness check is scheduled 60 seconds after activation",
    "working or active targets are skipped without queueing another wake",
    "appserver active and running normalize to working and are skipped without steering or queueing",
    "interrupted and idle targets receive a queue wake, never steer",
    "appserver interrupted and cancelled normalize to interrupted, and idle remains idle, before the queue wake",
    "appserver starting and stopping normalize to deferred states",
    "appserver systemError normalizes to failed",
    "appserver disconnected, failed, unknown, and notLoaded states fail closed without a queue wake",
    "the queue wake body names the goal file and instructs the target to continue executing the goal",
    "starting and stopping are deferred until a legal observation",
    "unknown, disconnected, failed, missing, and dead targets fail closed",
    "accepted, queued, delivered, executed, replied, and read are distinct evidence states",
    "uncertain delivery enters reconciliation and is never blindly retried"
  ],
  "required_evidence_events": [
    "register_goal",
    "clock_due",
    "native_active_or_running",
    "native_interrupted_or_cancelled",
    "native_idle",
    "native_starting_or_stopping",
    "native_system_error",
    "native_unknown_disconnected_or_not_loaded",
    "state_working",
    "state_interrupted_or_idle",
    "state_starting_or_stopping",
    "state_unknown_disconnected_failed_or_missing",
    "native_accept",
    "uncertain_transport",
    "matching_receipt"
  ],
  "evidence": [
    { "event": "register_goal", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness waits 60 seconds before the first wake" },
    { "event": "clock_due", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness wakes an idle target through queue" },
    { "event": "native_active_or_running", "test": "test/codexapp-entry.test.js", "case": "longhorizon liveness DAG applies every native status through the native bridge" },
    { "event": "native_interrupted_or_cancelled", "test": "test/codexapp-entry.test.js", "case": "longhorizon liveness DAG applies every native status through the native bridge" },
    { "event": "native_idle", "test": "test/codexapp-entry.test.js", "case": "longhorizon liveness DAG applies every native status through the native bridge" },
    { "event": "native_starting_or_stopping", "test": "test/codexapp-entry.test.js", "case": "longhorizon liveness DAG applies every native status through the native bridge" },
    { "event": "native_system_error", "test": "test/codexapp-entry.test.js", "case": "longhorizon liveness DAG applies every native status through the native bridge" },
    { "event": "native_unknown_disconnected_or_not_loaded", "test": "test/codexapp-entry.test.js", "case": "longhorizon liveness DAG applies every native status through the native bridge" },
    { "event": "state_working", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness skips a working target without queueing" },
    { "event": "state_working", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness applies the active idle interrupted state matrix through queue wake" },
    { "event": "state_interrupted_or_idle", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness wakes an interrupted target through queue" },
    { "event": "state_interrupted_or_idle", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness applies the active idle interrupted state matrix through queue wake" },
    { "event": "state_starting_or_stopping", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness defers while starting or stopping and resumes on idle" },
    { "event": "state_unknown_disconnected_failed_or_missing", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness fails closed for unknown disconnected failed" },
    { "event": "state_unknown_disconnected_failed_or_missing", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness records a missing session as terminal" },
    { "event": "native_accept", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness accepted evidence is not promoted to executed without matching receipt" },
    { "event": "uncertain_transport", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness uncertain delivery reconciles without blind retry" },
    { "event": "matching_receipt", "test": "test/longhorizon-liveness.test.js", "case": "longhorizon liveness uncertain delivery reconciles without blind retry" }
  ]
}
