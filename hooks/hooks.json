{
  "description": "RouteCodex hook adapters. Business policies are intentionally absent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?!update_goal$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind tool-call",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^update_goal$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind update-goal",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind tool-call",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!update_goal$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind tool-call",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^update_goal$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind update-goal",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind stop",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\" --kind stop",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/src/hook-entry.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
